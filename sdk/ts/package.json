{
  "name": "@pwrap/sdk",
  "version": "0.1.1",
  "description": "TypeScript SDK for pwrap \u2014 Postgres-backed all-in-one backend.",
  "license": "Apache-2.0",
  "author": "Berke Ucvet",
  "homepage": "https://github.com/b3vet/pwrap#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/b3vet/pwrap.git",
    "directory": "sdk/ts"
  },
  "bugs": {
    "url": "https://github.com/b3vet/pwrap/issues"
  },
  "keywords": [
    "postgres",
    "postgresql",
    "backend",
    "pgvector",
    "postgrest",
    "postgis",
    "jsonb",
    "realtime"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./neon": {
      "import": {
        "types": "./dist/neon.d.ts",
        "default": "./dist/neon.js"
      },
      "require": {
        "types": "./dist/neon.d.cts",
        "default": "./dist/neon.cjs"
      }
    }
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json && node scripts/dts-cjs.mjs",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test dist/*.test.js"
  },
  "dependencies": {
    "postgres": "^3.4.4"
  },
  "peerDependencies": {
    "@neondatabase/serverless": "^0.10.0",
    "ws": "^8.18.0"
  },
  "peerDependenciesMeta": {
    "@neondatabase/serverless": {
      "optional": true
    },
    "ws": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsup": "^8.0.2",
    "typescript": "^7.0.2"
  }
}
