# Binaries
# NOTE: keep these anchored with a leading slash. Unanchored `pwrapd` / `pwrap`
# match at any depth, which silently excludes cmd/pwrap, cmd/pwrapd,
# sdk/go/pwrap and sdk/py/pwrap — i.e. most of the source tree.
/bin/
/dist/
/pwrapd
/pwrap
*.exe

# Go
*.test
*.out
coverage.txt
coverage.html

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# Env (committed: .env.example; local: .env)
.env
.env.local
*.local
!.env.example

# Node / pnpm
node_modules/
sdk/ts/dist/
sdk/ts/.turbo/
pnpm-debug.log*

# Python build / test artifacts
__pycache__/
*.py[cod]
.pytest_cache/
sdk/py/build/
sdk/py/dist/
sdk/py/*.egg-info/

# Docker
.docker-data/

# Conformance suite scratch (reports, venv, logs)
conformance/.reports/
conformance/.venv/
conformance/ts/node_modules/
conformance/**/report-*.json
