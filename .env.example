# Copy to `.env` (auto-read by docker-compose) so PostgREST + pwrapd agree on the
# authenticator password and JWT signing secret. Override per-environment in CI/prod.

PWRAP_AUTHENTICATOR_PASSWORD=authpw-dev
PWRAP_JWT_SECRET=super-dev-jwt-secret-please-change-me-32bytes
PWRAP_BOOTSTRAP_TOKEN=dev-admin

# 32-byte AES-256 key, base64. Encrypts projects.pg_password at rest. Generate
# in prod with: head -c 32 /dev/urandom | base64
PWRAP_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# Optional OpenTelemetry. PWRAP_OTLP_ENDPOINT enables OTLP/HTTP export of traces
# and metrics. PWRAP_METRICS_ADDR additionally exposes a Prometheus /metrics
# endpoint at the given bind address. Both are optional; pwrapd runs without them.
# PWRAP_OTLP_ENDPOINT=http://localhost:4318
# PWRAP_METRICS_ADDR=:9464
